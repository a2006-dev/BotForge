<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        BotForge 应用主题（深色）
        - 使用 Dark 父主题，确保 Material 组件默认走深色分支（文字、弹窗、输入框）。
        - 系统栏颜色与窗口底色统一为 bg_primary，避免启动闪白。
    -->
    <style name="Theme.BotForge" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/bg_primary</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>

        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>

        <!-- 深色底 → 系统栏图标用浅色 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- 弹窗底色：跟随浮起层，避免纯黑突兀 -->
        <item name="android:colorBackgroundFloating">@color/bg_elevated</item>

        <!-- 文本主体色，供 AlertDialog / 原生控件继承 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- ============================================================
         兼容别名
         旧代码（XML）里可能引用 bg / card / accent / text_main 等名字，
         这里统一映射到新令牌，避免引用断裂。
         待所有页面迁移完成后可整块删除。
         ============================================================ -->
    <color name="bg">@color/bg_primary</color>
    <color name="card">@color/bg_card</color>
    <color name="accent">@color/accent_primary</color>
    <color name="text_main">@color/text_primary</color>
    <color name="text_sub">@color/text_secondary</color>
    <color name="ok">@color/status_success</color>
    <color name="warn">@color/status_warning</color>
    <color name="err">@color/status_error</color>

</resources>