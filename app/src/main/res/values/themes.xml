<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        主题 · v2
        v1 的问题：只改了窗口底色，系统控件（Button/Switch/EditText/Dialog）
        仍按浅色分支绘制，导致白底白字、灰块按钮。
        v2 用 Theme.AppCompat.NoActionBar（Dark 分支），并把所有会露白的地方
        逐个显式指定。
    -->
    <style name="Theme.BotForge" parent="Theme.AppCompat.NoActionBar">

        <!-- 品牌 -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/ink_0</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorControlNormal">@color/t_mid</item>
        <item name="colorControlHighlight">@color/ink_4</item>

        <!-- 窗口与系统栏 -->
        <item name="android:colorBackground">@color/ink_1</item>
        <item name="android:windowBackground">@color/ink_1</item>
        <item name="android:statusBarColor">@color/ink_0</item>
        <item name="android:navigationBarColor">@color/ink_0</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- 弹窗 / 菜单 -->
        <item name="android:colorBackgroundFloating">@color/ink_2</item>
        <item name="android:textColorPrimary">@color/t_hi</item>
        <item name="android:textColorSecondary">@color/t_mid</item>
        <item name="android:textColorHint">@color/t_low</item>
        <item name="android:textColorPrimaryInverse">@color/t_inverse</item>

        <!-- 分割线 -->
        <item name="android:listDivider">@color/line</item>
    </style>

    <!-- AlertDialog 专用主题：确保弹窗底与文字都是深色方案 -->
    <style name="Theme.BotForge.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/brand</item>
        <item name="android:colorBackground">@color/ink_2</item>
        <item name="android:textColorPrimary">@color/t_hi</item>
        <item name="android:textColorSecondary">@color/t_mid</item>
    </style>

    <!-- 兼容别名：其它页面可能引用了旧名字 -->
    <color name="bg">@color/ink_1</color>
    <color name="card">@color/ink_2</color>
    <color name="accent">@color/brand</color>
    <color name="text_main">@color/t_hi</color>
    <color name="text_sub">@color/t_mid</color>
    <color name="ok">@color/run</color>
    <color name="warn">@color/warn</color>
    <color name="err">@color/danger</color>

</resources>