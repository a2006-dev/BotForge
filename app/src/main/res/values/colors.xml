<?xml version="1.0" encoding="utf-8"?>
<!--
    BotForge 颜色令牌 · v2
    重做原因：v1 上线后首页出现「白底白字」「深色标题不可见」等硬伤，
    v2 收紧为更深的石墨底 + 更强层级差 + 明确语义状态色。
-->
<resources>

    <!-- 背景：从最深到最亮，共 5 级，保证卡片能与底色拉开 -->
    <color name="ink_0">#0B0D10</color>   <!-- 窗口底 -->
    <color name="ink_1">#12151A</color>   <!-- 页面底 -->
    <color name="ink_2">#1A1E25</color>   <!-- 卡片 -->
    <color name="ink_3">#232830</color>   <!-- 浮起 / 输入框 -->
    <color name="ink_4">#2D333D</color>   <!-- 描边上的高亮块 -->

    <!-- 文字：三级 + 反色 -->
    <color name="t_hi">#EDEFF2</color>    <!-- 主文字 -->
    <color name="t_mid">#9AA3B0</color>   <!-- 次要 -->
    <color name="t_low">#646C7A</color>   <!-- 提示 / 占位 -->
    <color name="t_inverse">#0B0D10</color>

    <!-- 品牌主色：冷蓝，只用于主操作和强调 -->
    <color name="brand">#5B8DEF</color>
    <color name="brand_press">#4574D6</color>
    <color name="brand_off">#31394A</color>

    <!-- 语义状态色（含低透明底，供标签用） -->
    <color name="run">#3DD68C</color>
    <color name="run_bg">#1F3DD68C</color>
    <color name="warn">#F5B54A</color>
    <color name="warn_bg">#1FF5B54A</color>
    <color name="danger">#F0646E</color>
    <color name="danger_bg">#1FF0646E</color>
    <color name="idle">#5A6270</color>
    <color name="idle_bg">#1F5A6270</color>

    <!-- 分隔 -->
    <color name="line">#252A32</color>
    <color name="line_strong">#333A45</color>

    <color name="clear">#00000000</color>

</resources>