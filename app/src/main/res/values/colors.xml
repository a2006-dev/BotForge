<?xml version="1.0" encoding="utf-8"?>
<!--
    BotForge 颜色令牌（唯一来源）
    - 只允许在这里定义具体色值，页面与组件必须通过 @color / ContextCompat.getColor 引用。
    - 命名规则：用途_层级，不出现具体色名（不要用 blue_dark 这类）。
-->
<resources>

    <!-- ===== 背景层级 ===== -->
    <color name="bg_primary">#111318</color>     <!-- 窗口底色 -->
    <color name="bg_secondary">#191C23</color>   <!-- 分区背景 / 顶栏 -->
    <color name="bg_card">#20242D</color>        <!-- 卡片 -->
    <color name="bg_elevated">#282D37</color>    <!-- 浮起层 / 弹层 / 输入框底 -->
    <color name="bg_input">#1C2028</color>       <!-- 输入框默认底 -->
    <color name="bg_overlay">#B3000000</color>   <!-- 遮罩 -->

    <!-- ===== 文字层级 ===== -->
    <color name="text_primary">#F3F4F6</color>   <!-- 标题、正文主信息 -->
    <color name="text_secondary">#A1A7B3</color> <!-- 次要说明、列表副标题 -->
    <color name="text_tertiary">#737B89</color>  <!-- 占位符、禁用、提示 -->
    <color name="text_on_accent">#0B0E13</color> <!-- 强调色上的文字 -->
    <color name="text_link">#6C9EFF</color>      <!-- 可点击文本 -->

    <!-- ===== 品牌强调色 ===== -->
    <color name="accent_primary">#6C9EFF</color>
    <color name="accent_pressed">#4F83E8</color>
    <color name="accent_disabled">#3A465C</color>
    <color name="accent_soft">#266C9EFF</color>  <!-- 强调色 15% 透明，用于标签底 -->

    <!-- ===== 状态色 ===== -->
    <color name="status_success">#42C98A</color>
    <color name="status_warning">#F2B85C</color>
    <color name="status_error">#F06B70</color>
    <color name="status_idle">#737B89</color>    <!-- 未启动 / 未知 -->

    <color name="status_success_soft">#2642C98A</color>
    <color name="status_warning_soft">#26F2B85C</color>
    <color name="status_error_soft">#26F06B70</color>
    <color name="status_idle_soft">#26737B89</color>

    <!-- ===== 分割线 / 描边 ===== -->
    <color name="divider">#303540</color>
    <color name="border">#2A2F3A</color>
    <color name="border_focused">#6C9EFF</color>

    <!-- ===== 日志等级（LogActivity 使用，与业务语义一一对应） ===== -->
    <color name="log_debug">#737B89</color>
    <color name="log_info">#6C9EFF</color>
    <color name="log_warn">#F2B85C</color>
    <color name="log_error">#F06B70</color>

    <!-- ===== 纯色（少用，仅限图标着色等场景） ===== -->
    <color name="transparent">#00000000</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

</resources>
